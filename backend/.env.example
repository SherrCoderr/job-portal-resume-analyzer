# ==============================================================================
# Environment Configuration Template (Copy to .env for local development)
# ==============================================================================

# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/jobportal_db
DB_USERNAME=postgres
DB_PASSWORD=your_database_password_here
HIBERNATE_DDL_AUTO=update

# Server Configuration
PORT=8080

# JWT Security (Must be a secure 256-bit+ Base64-encoded secret key)
JWT_SECRET=your_base64_encoded_256_bit_jwt_secret_key_here
JWT_EXPIRATION_MS=86400000

# File Storage Configuration
UPLOAD_DIR=uploads/resumes

# Frontend CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
